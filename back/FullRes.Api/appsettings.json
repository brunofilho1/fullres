{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FullRes": "Information"
    }
  },
  "AllowedHosts": "*",
  "FullRes": {
    "MaxUploadBytes": 20971520,
    "MaxImagePixels": 30000000,
    "ProviderMaxImageBytes": 512000,
    "ProviderTimeoutSeconds": 20,
    "MaxConcurrentSearches": 4,
    "Probe": {
      "Enabled": true,
      "TimeoutSeconds": 6,
      "MaxConcurrent": 4,
      "MaxResults": 30,
      "MaxRedirects": 3,
      "HeaderByteLimit": 131072
    },
    "Cors": {
      "AllowedOrigins": [ "http://localhost:5173" ]
    },
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Resilience": {
      "MaxRetries": 2,
      "RetryBaseDelayMs": 300,
      "CircuitBreakerEnabled": true,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerOpenSeconds": 30,
      "QuotaCooldownSeconds": 600
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    },
    "SerpApi": {
      "ApiKey": "",
      "SearchEndpoint": "https://serpapi.com/search",
      "UploadEndpoint": "https://serpapi.com/image",
      "Country": "",
      "Language": ""
    }
  }
}

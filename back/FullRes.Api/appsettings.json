{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FullRes": "Information"
    }
  },
  "AllowedHosts": "*",
  "FullRes": {
    "MaxUploadBytes": 20971520,
    "MaxImagePixels": 30000000,
    "ProviderMaxImageBytes": 512000,
    "ProviderTimeoutSeconds": 20,
    "Probe": {
      "Enabled": true,
      "TimeoutSeconds": 6,
      "MaxConcurrent": 4,
      "MaxResults": 30,
      "MaxRedirects": 3,
      "HeaderByteLimit": 131072
    },
    "Cors": {
      "AllowedOrigins": [ "http://localhost:5173" ]
    },
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "SerpApi": {
      "ApiKey": "",
      "SearchEndpoint": "https://serpapi.com/search",
      "UploadEndpoint": "https://serpapi.com/image",
      "Country": "",
      "Language": ""
    }
  }
}

# Copy to back/.env (git-ignored) or export in your shell before `dotnet run`.
# ASP.NET Core reads these as normal configuration (double underscore = section separator).

# ASPNETCORE_URLS=http://localhost:5080

# SerpApi key from https://serpapi.com/manage-api-key (free tier: 250 searches/month).
# Without a key the API still starts; POST /api/images/search returns 503 provider_not_configured.
FullRes__SerpApi__ApiKey=

# Optional overrides (defaults live in FullRes.Api/appsettings.json)
# FullRes__SerpApi__SearchEndpoint=https://serpapi.com/search
# FullRes__SerpApi__UploadEndpoint=https://serpapi.com/image
# FullRes__SerpApi__Country=br
# FullRes__SerpApi__Language=pt
# FullRes__MaxUploadBytes=20971520
# FullRes__MaxImagePixels=30000000
# FullRes__ProviderMaxImageBytes=512000
# FullRes__ProviderTimeoutSeconds=20
# FullRes__MaxConcurrentSearches=4
# FullRes__Resilience__MaxRetries=2
# FullRes__Resilience__RetryBaseDelayMs=300
# FullRes__Resilience__CircuitBreakerEnabled=true
# FullRes__Resilience__CircuitBreakerFailureThreshold=5
# FullRes__Resilience__CircuitBreakerOpenSeconds=30
# FullRes__Resilience__QuotaCooldownSeconds=600
# FullRes__Probe__Enabled=true
# FullRes__Probe__MaxResults=30
# FullRes__RateLimit__PermitLimit=20
# FullRes__RateLimit__WindowSeconds=60
# FullRes__Cors__AllowedOrigins__0=http://localhost:5173

# Trust X-Forwarded-For/-Proto only behind a proxy you control. List the proxy IPs in
# KnownProxies; leaving it empty trusts loopback only. Enabling this without pinning the
# proxy lets clients spoof their IP and bypass the per-IP rate limit.
# FullRes__ForwardedHeaders__Enabled=false
# FullRes__ForwardedHeaders__KnownProxies__0=10.0.0.10
